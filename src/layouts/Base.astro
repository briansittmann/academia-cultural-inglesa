---
/**
 * Layout base: <head> con SEO (title, description, Open Graph, canonical,
 * JSON-LD), fuente alojada en el proyecto, favicons, header y footer.
 */
import '@fontsource-variable/plus-jakarta-sans';
import '../styles/global.css';
import { getEntry } from 'astro:content';
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import DatosEstructurados from '../components/DatosEstructurados.astro';

interface Props {
  title?: string; // si no se pasa, usa el título SEO del instituto
  description?: string;
  ogImage?: string; // ruta absoluta dentro del sitio, ej. "/og.jpg"
  ogImageAncho?: number;
  ogImageAlto?: number;
  ogImageAlt?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
}

const instituto = await getEntry('instituto', 'instituto');
if (!instituto) throw new Error('Falta src/content/instituto/instituto.yaml');
const { seo, nombre } = instituto.data;

const {
  title = seo.titulo,
  description = seo.descripcion,
  ogImage = seo.imagen?.src ?? '/og.jpg',
  ogImageAncho = 1200,
  ogImageAlto = 630,
  ogImageAlt = `Logo de ${nombre}`,
  ogType = 'website',
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL(ogImage, Astro.site);
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}

    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" href="/favicon-96.png" type="image/png" sizes="96x96" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#2E6B34" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={nombre} />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content={String(ogImageAncho)} />
    <meta property="og:image:height" content={String(ogImageAlto)} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <meta name="generator" content={Astro.generator} />
    <DatosEstructurados />
    <ClientRouter />
    <slot name="head" />
    {/* Marca que hay JS: los estados iniciales de las animaciones dependen de esta clase. */}
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body class="flex min-h-dvh flex-col">
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:rounded-control focus:bg-verde-700 focus:px-3 focus:py-2 focus:text-white"
    >
      Ir al contenido
    </a>
    <div class="absolute top-0 left-0 h-px w-px" data-centinela aria-hidden="true"></div>
    <Header />
    <main id="contenido" class="flex-1">
      <slot />
    </main>
    <Footer />
    <script>
      // Scroll reveal (receta de motion-skills): una sola vez por elemento.
      function revelar(el: Element) {
        el.setAttribute('data-visible', '');
        el.querySelectorAll<HTMLElement>('[data-cifra]').forEach(contar);
      }
      // Cualquier componente puede repetir su entrada disparando el evento "revelar".
      document.addEventListener('revelar', (e) => revelar(e.target as Element));

      function iniciarReveal() {
        const elementos = document.querySelectorAll<HTMLElement>('[data-reveal]:not([data-visible])');
        if (elementos.length === 0) return;
        if (!('IntersectionObserver' in window)) {
          elementos.forEach(revelar);
          return;
        }
        const io = new IntersectionObserver(
          (entradas) => {
            entradas.forEach((e) => {
              if (!e.isIntersecting) return;
              revelar(e.target);
              io.unobserve(e.target);
            });
          },
          { rootMargin: '0px 0px -10% 0px', threshold: 0.1 },
        );
        elementos.forEach((el) => io.observe(el));
      }
      // Contador: la cifra sube de 0 al valor final en 900 ms con ease-out (WAAPI no
      // anima texto, así que se interpola en requestAnimationFrame).
      function contar(el: HTMLElement) {
        const fin = Number(el.dataset.cifra);
        if (!Number.isFinite(fin) || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        const inicio = performance.now();
        const duracion = 900;
        const easeOut = (t: number) => 1 - Math.pow(1 - t, 4);
        function paso(ahora: number) {
          const t = Math.min(1, (ahora - inicio) / duracion);
          el.textContent = String(Math.round(easeOut(t) * fin));
          if (t < 1) requestAnimationFrame(paso);
        }
        el.textContent = '0';
        requestAnimationFrame(paso);
      }
      document.addEventListener('astro:page-load', iniciarReveal);
    </script>
  </body>
</html>
