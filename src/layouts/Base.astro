---
/**
 * Layout base: <head> con SEO (title, description, Open Graph, canonical),
 * fuente alojada en el proyecto, favicon, header y footer.
 */
import '@fontsource-variable/plus-jakarta-sans';
import '../styles/global.css';
import { getEntry } from 'astro:content';
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string; // si no se pasa, usa el título SEO del instituto
  description?: string;
  ogImage?: string; // ruta absoluta dentro del sitio, ej. "/og.jpg"
  ogType?: 'website' | 'article';
  noindex?: boolean;
}

const instituto = await getEntry('instituto', 'instituto');
if (!instituto) throw new Error('Falta src/content/instituto/instituto.yaml');
const { seo, nombre } = instituto.data;

const {
  title = seo.titulo,
  description = seo.descripcion,
  ogImage = seo.imagen?.src ?? '/og.jpg',
  ogType = 'website',
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL(ogImage, Astro.site);
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#2E6B34" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={nombre} />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`Escudo de ${nombre}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <meta name="generator" content={Astro.generator} />
    <ClientRouter />
    <slot name="head" />
    {/* Marca que hay JS: los estados iniciales de las animaciones dependen de esta clase. */}
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body class="flex min-h-dvh flex-col">
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:rounded-control focus:bg-verde-700 focus:px-3 focus:py-2 focus:text-white"
    >
      Ir al contenido
    </a>
    <Header />
    <main id="contenido" class="flex-1">
      <slot />
    </main>
    <Footer />
    <script>
      // Scroll reveal (receta de motion-skills): una sola vez por elemento.
      function iniciarReveal() {
        const elementos = document.querySelectorAll<HTMLElement>('[data-reveal]:not([data-visible])');
        if (elementos.length === 0) return;
        if (!('IntersectionObserver' in window)) {
          elementos.forEach((el) => el.setAttribute('data-visible', ''));
          return;
        }
        const io = new IntersectionObserver(
          (entradas) => {
            entradas.forEach((e) => {
              if (!e.isIntersecting) return;
              e.target.setAttribute('data-visible', '');
              io.unobserve(e.target);
            });
          },
          { rootMargin: '0px 0px -10% 0px', threshold: 0.1 },
        );
        elementos.forEach((el) => io.observe(el));
      }
      document.addEventListener('astro:page-load', iniciarReveal);
    </script>
  </body>
</html>
