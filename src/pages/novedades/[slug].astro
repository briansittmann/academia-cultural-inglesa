---
/**
 * Página propia de cada novedad vigente: flyer (si hay), texto largo, horarios
 * cargados en la entrada y los cursos que incluye. Solo se generan las vigentes;
 * al desmarcar "Vigente" en el panel la página deja de publicarse.
 */
import { getCollection, getEntry, render } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import Base from '../../layouts/Base.astro';
import Boton from '../../components/Boton.astro';
import Etiqueta from '../../components/Etiqueta.astro';
import TituloAnimado from '../../components/TituloAnimado.astro';
import { sedeParaWhatsapp } from '../../lib/sedes';

export async function getStaticPaths() {
  const novedades = await getCollection('novedades', ({ data }) => data.vigente);
  return novedades.map((novedad) => ({ params: { slug: novedad.id }, props: { novedad } }));
}
const { novedad } = Astro.props;
const d = novedad.data;

const instituto = await getEntry('instituto', 'instituto');
if (!instituto) throw new Error('Falta src/content/instituto/instituto.yaml');
const sedeWhatsapp = await sedeParaWhatsapp();

const cursos = (await Promise.all(d.cursos.map((ref) => getEntry(ref)))).flatMap((c) => (c ? [c] : []));
const horarios = await Promise.all(
  d.horarios.map(async (h) => ({ ...h, sedeNombre: h.sede ? (await getEntry(h.sede))?.data.nombre : undefined })),
);
const publicos = new Map(
  (await Promise.all(cursos.map(async (c) => [c.id, await getEntry(c.data.publico)] as const))).map(([id, p]) => [id, p]),
);
const formulario = cursos.find((c) => c.data.formulario)?.data.formulario ?? instituto.data.formularios.consultaGeneral;
const whatsappUrl = `https://wa.me/${sedeWhatsapp.data.whatsapp.internacional}?text=${encodeURIComponent(sedeWhatsapp.data.whatsapp.mensaje ?? '')}`;

const { Content } = await render(novedad);
const title = `${d.titulo} | ${instituto.data.nombre}`;
const description = d.resumen.length > 160 ? `${d.resumen.slice(0, 157).trimEnd()}...` : d.resumen;
// Al compartir, va el flyer si lo hay; si no, la imagen con el logo.
const og = d.flyer ? await getImage({ src: d.flyer, width: 1200, format: 'jpg' }) : undefined;
---

<Base
  title={title}
  description={description}
  ogType="article"
  ogImage={og?.src}
  ogImageAncho={og?.attributes.width}
  ogImageAlto={og?.attributes.height}
  ogImageAlt={d.flyerAlt}
>
  <article>
    <header class="border-b border-borde/50 bg-verde-50/60">
      <div class="mx-auto max-w-6xl px-4 pt-8 pb-10 sm:px-6 lg:pt-12 lg:pb-14">
        <a href="/#novedades" class="hero-eyebrow volver inline-flex items-center gap-1 rounded-control text-sm font-semibold text-verde-700 hover:text-verde-900">
          <Icon name="material-symbols:arrow-back-rounded" class="flecha-volver size-4" aria-hidden="true" />
          Novedades
        </a>
        <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-2">
          <TituloAnimado as="h1" texto={d.titulo} retraso={80} class="text-[2.25rem] leading-[1.05] sm:text-5xl" />
          <Etiqueta tono="dorado" class="hero-bajada text-sm">{d.periodo}</Etiqueta>
        </div>
        <p class="hero-bajada mt-4 max-w-[40rem] text-lg leading-relaxed text-tinta-suave sm:text-xl">{d.resumen}</p>
      </div>
    </header>

    <div class="mx-auto grid max-w-6xl gap-10 px-4 py-10 sm:px-6 lg:grid-cols-12 lg:gap-14 lg:py-16">
      <div class="lg:col-span-7" data-reveal>
        {/* La página se arma por partes: cada bloque del texto, cada fila y cada tarjeta entra
            de a uno (.cascada en animaciones.css) cuando su sección aparece en pantalla. */}
        <div class="prosa cascada [--base:500ms]" data-reveal>
          <Content />
        </div>

        {
          horarios.length > 0 && (
            <section class="mt-10" aria-labelledby="horarios" data-reveal>
              <h2 id="horarios" class="sube text-2xl">Días y horarios</h2>
              <ul class="cascada cascada-izquierda mt-4 divide-y divide-borde/60 border-y border-borde/60">
                {horarios.map((h) => (
                  <li class="grid gap-x-6 gap-y-1 py-3 sm:grid-cols-[1fr_auto]">
                    <div>
                      {h.nombre && <p class="font-semibold text-verde-900">{h.nombre}</p>}
                      <p class="text-tinta-suave">
                        {h.sedeNombre && <span class="font-medium text-tinta">{h.sedeNombre}: </span>}
                        {h.dias} de {h.horas}
                      </p>
                    </div>
                    {h.fechas && <p class="text-sm text-tinta-suave sm:text-right">{h.fechas}</p>}
                  </li>
                ))}
              </ul>
            </section>
          )
        }

        {
          cursos.length > 0 && (
            <section class="mt-10" aria-labelledby="cursos-incluidos" data-reveal>
              <h2 id="cursos-incluidos" class="sube text-2xl">Cursos incluidos</h2>
              <ul class="cascada mt-4 grid gap-3 sm:grid-cols-2">
                {cursos.map((c) => (
                  <li>
                    <a
                      href={`/cursos/${c.id}`}
                      class="tarjeta-elevable tarjeta-novedad flex h-full flex-col rounded-card border border-borde/60 bg-white p-5"
                    >
                      <span class="text-xs font-semibold text-tinta-suave">{publicos.get(c.id)?.data.nombre}</span>
                      <span class="mt-1 text-lg font-bold text-verde-900">{c.data.nombre}</span>
                      <span class="mt-1 text-sm text-tinta-suave">{c.data.para}</span>
                      <span class="mt-3 inline-flex items-center gap-1 text-sm font-semibold text-verde-700">
                        Más sobre el curso
                        <Icon name="material-symbols:arrow-forward-rounded" class="flecha-avanza size-4" aria-hidden="true" />
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          )
        }
      </div>

      <aside class="lg:col-span-5" data-reveal>
        {/* El lateral entra desde la derecha: primero el flyer (la imagen se descubre de
            derecha a izquierda), después los botones. */}
        <div class="cascada cascada-derecha lg:sticky lg:top-24 lg:[--base:500ms]">
          {
            d.flyer && (
              <figure class="pagina-flyer overflow-hidden rounded-card border border-borde/60 bg-white shadow-card">
                <Image src={d.flyer} alt={d.flyerAlt ?? ''} widths={[480, 800, 1200]} sizes="(min-width: 1024px) 40vw, 100vw" class="w-full" />
              </figure>
            )
          }
          <div class:list={['flex flex-col gap-3', d.flyer && 'mt-5']}>
            <Boton href={formulario} variante="primario" icono="material-symbols:open-in-new-rounded" externo class="w-full">
              Pedir información
            </Boton>
            <Boton href={whatsappUrl} variante="whatsapp" icono="material-symbols:chat-rounded" externo elegirSede class="w-full">
              Escribir por WhatsApp
            </Boton>
          </div>
        </div>
      </aside>
    </div>
  </article>
</Base>
