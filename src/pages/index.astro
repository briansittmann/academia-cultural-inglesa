---
/**
 * Landing de una sola página. Las secciones se agregan de a una o dos por fase
 * según docs/fase-1-analisis.md §4. Lo que falta queda como esqueleto al final.
 */
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Hero from '../components/secciones/Hero.astro';

const publicos = (await getCollection('publicos')).sort((a, b) => a.data.orden - b.data.orden);
const cursos = (await getCollection('cursos')).sort((a, b) => a.data.orden - b.data.orden);
---

<Base>
  <Hero />

  {/* Esqueleto provisorio: se reemplaza por Cursos, Cambridge, La Academia, Cómo empezar y Sedes. */}
  <section id="cursos" class="mx-auto max-w-6xl scroll-mt-16 px-4 py-16 sm:px-6">
    <h2 class="text-3xl">Cursos</h2>
    <div class="mt-6 grid gap-6 md:grid-cols-2">
      {
        publicos.map((publico) => (
          <article id={publico.data.ancla} class="rounded-card border border-borde/60 bg-white p-6 shadow-card">
            <h3 class="text-xl">{publico.data.titulo}</h3>
            <p class="mt-2 text-sm text-tinta-suave">{publico.data.descripcion}</p>
            <ol class="mt-4 space-y-1 text-sm">
              {cursos
                .filter((c) => c.data.publico.id === publico.id)
                .map((c) => (
                  <li>
                    <strong>{c.data.nombre}</strong>
                    {c.data.periodo && <span class="text-tinta-suave">, {c.data.periodo.toLowerCase()}</span>}
                  </li>
                ))}
            </ol>
          </article>
        ))
      }
    </div>
  </section>
  <section id="sedes" class="scroll-mt-16"></section>
  <section id="nosotros" class="scroll-mt-16"></section>
</Base>
