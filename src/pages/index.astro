---
/**
 * Landing de una sola página. Secciones según docs/fase-1-analisis.md §4.
 */
import Base from '../layouts/Base.astro';
import Hero from '../components/secciones/Hero.astro';
import Novedades from '../components/secciones/Novedades.astro';
import Cursos from '../components/secciones/Cursos.astro';
import Cambridge from '../components/secciones/Cambridge.astro';
import Academia from '../components/secciones/Academia.astro';
import ComoEmpezar from '../components/secciones/ComoEmpezar.astro';
import Sedes from '../components/secciones/Sedes.astro';
import { getEntry } from 'astro:content';

// Cambridge sale del público con identificador "cambridge": si se borra o se le
// cambia el identificador en el panel, la sección no se muestra (y el build sigue).
const hayCambridge = Boolean(await getEntry('publicos', 'cambridge'));
---

<Base>
  <Hero />
  <Novedades />
  <Cursos />
  {hayCambridge && <Cambridge />}
  <Academia />
  <ComoEmpezar />
  <Sedes />
</Base>
