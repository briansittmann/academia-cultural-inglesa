---
/**
 * Selector de sede para WhatsApp. Cada sede tiene su número, así que los botones
 * "Escribir por WhatsApp" que no son de una sede en particular (header, hero,
 * novedades, cursos que se dan en más de una sede) abren este selector en vez
 * del chat. Esos botones llevan data-elegir-sede (lo pone Boton.astro con la
 * prop elegirSede) y, si el mensaje no es el de cada sede, data-mensaje. Sin JS,
 * el link va al WhatsApp principal.
 *
 * Es un <dialog> modal: el navegador atrapa el foco, cierra con Escape y deja
 * inerte el resto de la página. Se anima con WAAPI porque la salida tiene que
 * terminar antes de dialog.close():
 * - Hasta 639 px, hoja que sube desde abajo (receta drawer: 500 ms, curva de cajón).
 * - Desde 640 px, popover que sale del botón tocado (receta popover: escala 0,95
 *   con el origen en el botón, 220 ms), abajo o arriba según el lugar que haya.
 * - Las opciones entran en cascada. Reduced motion: solo opacidad.
 */
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';

const sedes = (await getCollection('sedes')).sort((a, b) => a.data.orden - b.data.orden);
---

<dialog class="selector-sede" aria-labelledby="selector-sede-titulo" data-selector-sede>
  <div class="selector-fondo absolute inset-0 bg-tinta/35 sm:bg-tinta/10" data-selector-fondo></div>
  <div
    class="selector-panel absolute inset-x-0 bottom-0 max-h-[85dvh] overflow-y-auto rounded-t-card bg-crema px-4 pt-5 pb-[max(1.25rem,env(safe-area-inset-bottom))] shadow-flotante outline-none sm:inset-x-auto sm:bottom-auto sm:w-[22.5rem] sm:rounded-card sm:border sm:border-borde/60 sm:p-4"
    tabindex="-1"
    autofocus
    data-selector-panel
  >
    <div class="selector-item flex items-start justify-between gap-4 pl-1">
      <div>
        <h2 id="selector-sede-titulo" class="text-lg leading-snug">¿A qué sede le escribís?</h2>
        <p class="mt-0.5 text-sm text-tinta-suave">Elegí la que te quede más cerca.</p>
      </div>
      <button
        type="button"
        class="-mt-1 -mr-1 inline-flex size-10 shrink-0 items-center justify-center rounded-full text-tinta-suave hover:bg-verde-100 hover:text-verde-900"
        data-selector-cerrar
      >
        <span class="sr-only">Cerrar</span>
        <Icon name="material-symbols:close-rounded" class="size-6" aria-hidden="true" />
      </button>
    </div>

    <ul class="mt-4 flex flex-col gap-2.5">
      {
        sedes.map(({ data: s }) => (
          <li class="selector-item">
            <a
              href={`https://wa.me/${s.whatsapp.internacional}?text=${encodeURIComponent(s.whatsapp.mensaje ?? '')}`}
              target="_blank"
              rel="noopener"
              class="selector-opcion group flex items-center gap-4 rounded-card border border-borde/70 bg-white p-3 no-underline hover:border-whatsapp hover:bg-verde-50"
              data-internacional={s.whatsapp.internacional}
              data-mensaje-sede={s.whatsapp.mensaje ?? ''}
            >
              {s.foto ? (
                <span class="size-14 shrink-0 overflow-hidden rounded-control bg-verde-100">
                  <Image src={s.foto} alt="" width={112} loading="eager" class="selector-foto size-full object-cover" />
                </span>
              ) : (
                <span class="flex size-14 shrink-0 items-center justify-center rounded-control bg-verde-100 text-verde-700">
                  <Icon name="material-symbols:location-on-outline" class="size-7" aria-hidden="true" />
                </span>
              )}
              <span class="min-w-0 flex-1">
                <span class="block font-bold text-verde-900">
                  <span class="sr-only">Escribir por WhatsApp a la sede </span>
                  {s.nombre}
                </span>
                <span class="block text-sm text-tinta-suave">{s.direccion}</span>
                <span class="mt-0.5 flex items-center gap-1.5 text-sm font-semibold text-verde-700">
                  <Icon name="material-symbols:chat-rounded" class="size-4 shrink-0" aria-hidden="true" />
                  {s.whatsapp.numero}
                </span>
              </span>
              <span class="selector-flecha flex size-10 shrink-0 items-center justify-center rounded-full bg-verde-100 text-verde-900 group-hover:bg-whatsapp group-hover:text-tinta">
                <Icon name="material-symbols:arrow-outward-rounded" class="selector-flecha-icono size-5" aria-hidden="true" />
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</dialog>

<style>
  /* El <dialog> ocupa toda la pantalla y es transparente: el fondo y el panel son
     elementos propios para poder animarlos con WAAPI (::backdrop no se anima bien). */
  .selector-sede {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    overflow: hidden;
  }
  .selector-sede::backdrop {
    background: transparent;
  }
  :global(html:has(.selector-sede[open])) {
    overflow: hidden;
    scrollbar-gutter: stable;
  }
  /* Popover: la posición y el origen los calcula el script según el botón tocado. */
  @media (min-width: 40rem) {
    .selector-panel {
      left: var(--x, 50%);
      top: var(--y, 50%);
      transform-origin: var(--origen, center);
    }
  }

  .selector-opcion {
    transition:
      transform 160ms var(--ease-out),
      background-color 200ms var(--ease-out),
      border-color 200ms var(--ease-out);
  }
  .selector-opcion:active {
    transform: scale(0.98);
  }
  .selector-flecha {
    transition:
      background-color 200ms var(--ease-out),
      color 200ms var(--ease-out);
  }
  .selector-flecha-icono,
  .selector-foto {
    transition: translate 250ms var(--ease-out), scale 400ms var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .selector-opcion:hover .selector-flecha-icono {
      translate: 2px -2px;
    }
    .selector-opcion:hover .selector-foto {
      scale: 1.08;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .selector-opcion:active {
      transform: none;
    }
    .selector-opcion:hover :is(.selector-flecha-icono, .selector-foto) {
      translate: none;
      scale: none;
    }
  }
</style>

<script>
  const HOJA = '(max-width: 39.99rem)';
  const EASE_OUT = 'cubic-bezier(0.23, 1, 0.32, 1)';
  const EASE_DRAWER = 'cubic-bezier(0.32, 0.72, 0, 1)';

  // Animaciones del panel y el fondo en curso, para poder interrumpirlas.
  let enCurso: Animation[] = [];

  function partes(dialog: HTMLDialogElement) {
    return {
      panel: dialog.querySelector<HTMLElement>('[data-selector-panel]')!,
      fondo: dialog.querySelector<HTMLElement>('[data-selector-fondo]')!,
      items: [...dialog.querySelectorAll<HTMLElement>('.selector-item')],
    };
  }

  const reducido = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /** Ubica el popover junto al botón: abajo si entra, si no arriba; del lado del botón. */
  function ubicar(panel: HTMLElement, boton: HTMLElement) {
    const r = boton.getBoundingClientRect();
    const ancho = panel.offsetWidth;
    const alto = panel.offsetHeight;
    const margen = 16;
    const separacion = 8;
    const vw = document.documentElement.clientWidth;
    const vh = window.innerHeight;
    const aLaDerecha = r.left + r.width / 2 > vw / 2;
    const x = Math.min(Math.max(aLaDerecha ? r.right - ancho : r.left, margen), vw - ancho - margen);
    const abajo = r.bottom + separacion + alto <= vh - margen || r.top - separacion - alto < margen;
    const y = Math.max(margen, abajo ? r.bottom + separacion : r.top - separacion - alto);
    const origenX = Math.min(Math.max(r.left + r.width / 2 - x, 0), ancho);
    panel.style.setProperty('--x', `${x}px`);
    panel.style.setProperty('--y', `${y}px`);
    panel.style.setProperty('--origen', `${origenX}px ${abajo ? 0 : alto}px`);
  }

  function abrir(dialog: HTMLDialogElement, boton: HTMLElement) {
    if (dialog.open) return;
    const { panel, fondo, items } = partes(dialog);

    // El mensaje del botón (por ejemplo, el del curso) o el de cada sede.
    const mensaje = boton.dataset.mensaje;
    dialog.querySelectorAll<HTMLAnchorElement>('[data-internacional]').forEach((a) => {
      const texto = mensaje ?? a.dataset.mensajeSede ?? '';
      a.href = `https://wa.me/${a.dataset.internacional}?text=${encodeURIComponent(texto)}`;
    });

    delete dialog.dataset.cerrando;
    dialog.showModal();
    const hoja = window.matchMedia(HOJA).matches;
    if (!hoja) ubicar(panel, boton);

    enCurso.forEach((a) => a.cancel());
    if (reducido()) {
      enCurso = [panel, fondo].map((el) => el.animate({ opacity: [0, 1] }, { duration: 200, easing: EASE_OUT }));
      return;
    }
    enCurso = [
      hoja
        ? panel.animate({ transform: ['translateY(100%)', 'translateY(0)'] }, { duration: 500, easing: EASE_DRAWER })
        : panel.animate({ opacity: [0, 1], transform: ['scale(0.95)', 'scale(1)'] }, { duration: 220, easing: EASE_OUT }),
      fondo.animate({ opacity: [0, 1] }, { duration: hoja ? 400 : 220, easing: EASE_OUT }),
    ];
    // Cascada: en la hoja, mientras sube; en el popover, más corta y sutil.
    items.forEach((item, i) =>
      item.animate(
        { opacity: [0, 1], transform: [hoja ? 'translateY(16px)' : 'translateY(6px)', 'translateY(0)'] },
        { duration: hoja ? 450 : 300, delay: hoja ? 120 + i * 60 : 50 + i * 40, easing: EASE_OUT, fill: 'backwards' },
      ),
    );
  }

  function cerrar(dialog: HTMLDialogElement) {
    if (!dialog.open || dialog.dataset.cerrando !== undefined) return;
    dialog.dataset.cerrando = '';
    const { panel, fondo } = partes(dialog);
    const hoja = window.matchMedia(HOJA).matches;

    // Sale desde donde esté, aunque la entrada no haya terminado.
    const desdePanel = getComputedStyle(panel);
    const desdeFondo = Number(getComputedStyle(fondo).opacity);
    const transform = desdePanel.transform === 'none' ? 'translateY(0)' : desdePanel.transform;
    const opacity = Number(desdePanel.opacity);
    enCurso.forEach((a) => a.cancel());

    const opciones: KeyframeAnimationOptions = { duration: 150, easing: EASE_OUT, fill: 'forwards' };
    let salida: Animation;
    if (reducido()) {
      salida = panel.animate({ opacity: [opacity, 0] }, opciones);
    } else if (hoja) {
      salida = panel.animate({ transform: [transform, 'translateY(100%)'] }, { ...opciones, duration: 320, easing: EASE_DRAWER });
    } else {
      salida = panel.animate({ opacity: [opacity, 0], transform: [transform, 'scale(0.97)'] }, opciones);
    }
    enCurso = [salida, fondo.animate({ opacity: [desdeFondo, 0] }, { ...opciones, duration: hoja ? 250 : 150 })];
    salida.finished.then(() => dialog.close()).catch(() => {});
  }

  // Un solo listener para toda la página: los botones pueden estar en cualquier lado.
  document.addEventListener('click', (e) => {
    const boton = (e.target as Element).closest<HTMLElement>('[data-elegir-sede]');
    if (!boton || e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
    const dialog = document.querySelector<HTMLDialogElement>('[data-selector-sede]');
    if (!dialog) return; // sin selector, el link va al WhatsApp principal
    e.preventDefault();
    abrir(dialog, boton);
  });

  // Si cambia el ancho con el selector abierto (de hoja a popover), se cierra sin animación.
  window.matchMedia(HOJA).addEventListener('change', () => {
    const dialog = document.querySelector<HTMLDialogElement>('[data-selector-sede]');
    if (dialog?.open) dialog.close();
  });

  function iniciarSelector() {
    const dialog = document.querySelector<HTMLDialogElement>('[data-selector-sede]');
    if (!dialog || dialog.dataset.listo) return;
    dialog.dataset.listo = 'true';

    // Escape: se cierra con animación en vez de golpe.
    dialog.addEventListener('cancel', (e) => {
      e.preventDefault();
      cerrar(dialog);
    });
    // Si el navegador lo cierra igual (un segundo Escape), se limpian las animaciones.
    dialog.addEventListener('close', () => {
      enCurso.forEach((a) => a.cancel());
      enCurso = [];
      delete dialog.dataset.cerrando;
    });
    dialog.querySelector('[data-selector-fondo]')!.addEventListener('click', () => cerrar(dialog));
    dialog.querySelector('[data-selector-cerrar]')!.addEventListener('click', () => cerrar(dialog));
    // Al elegir una sede, WhatsApp se abre en otra pestaña o en la app y el selector se va.
    dialog.querySelectorAll('[data-internacional]').forEach((a) => a.addEventListener('click', () => cerrar(dialog)));
  }
  document.addEventListener('astro:page-load', iniciarSelector);
</script>
