---
/**
 * Footer: placeholder mínimo para la fase 2 (escudo, sedes, email, Facebook).
 * En la fase 3 se completa con anclas y layout en columnas.
 */
import { getEntry, getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';
import Logo from './Logo.astro';

const instituto = await getEntry('instituto', 'instituto');
if (!instituto) throw new Error('Falta src/content/instituto/instituto.yaml');
const sedes = (await getCollection('sedes')).sort((a, b) => a.data.orden - b.data.orden);
const anio = new Date().getFullYear();
---

<footer class="bg-verde-900 text-verde-100">
  <div class="mx-auto grid max-w-6xl gap-8 px-4 py-12 sm:px-6 md:grid-cols-3">
    <div class="flex items-start gap-3">
      <Logo size={48} alt="" />
      <p class="text-sm leading-relaxed">
        <strong class="block text-white">{instituto.data.nombre}</strong>
        {instituto.data.bajada}
      </p>
    </div>
    {
      sedes.map((sede) => (
        <address class="text-sm not-italic leading-relaxed">
          <strong class="block text-white">Sede {sede.data.nombre}</strong>
          <span class="flex items-center gap-1.5">
            <Icon name="material-symbols:location-on-outline" class="size-4 shrink-0" aria-hidden="true" />
            {sede.data.direccion}, {sede.data.ciudad}
          </span>
          {sede.data.telefonos.map((t) => (
            <a href={`tel:${t.tel}`} class="flex items-center gap-1.5 hover:text-white">
              <Icon name="material-symbols:call-outline" class="size-4 shrink-0" aria-hidden="true" />
              {t.numero}
            </a>
          ))}
          <a
            href={`https://wa.me/${sede.data.whatsapp.internacional}?text=${encodeURIComponent(sede.data.whatsapp.mensaje ?? '')}`}
            class="flex items-center gap-1.5 hover:text-white"
            rel="noopener"
          >
            <Icon name="material-symbols:chat-outline" class="size-4 shrink-0" aria-hidden="true" />
            WhatsApp {sede.data.whatsapp.numero}
          </a>
          <a href={`mailto:${sede.data.email}`} class="flex items-center gap-1.5 hover:text-white">
            <Icon name="material-symbols:mail-outline" class="size-4 shrink-0" aria-hidden="true" />
            {sede.data.email}
          </a>
        </address>
      ))
    }
  </div>
  <div class="border-t border-white/10">
    <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-2 px-4 py-4 text-xs sm:px-6">
      <span>© {anio} {instituto.data.nombre}. Desde {instituto.data.fundacion}.</span>
      <span class="flex gap-4">
        <a href={`mailto:${instituto.data.email}`} class="hover:text-white">{instituto.data.email}</a>
        {instituto.data.redes.facebook && (
          <a href={instituto.data.redes.facebook} rel="noopener" target="_blank" class="hover:text-white">Facebook</a>
        )}
      </span>
    </div>
  </div>
</footer>
