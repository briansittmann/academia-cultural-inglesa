---
/**
 * Cambridge: la única banda oscura de la página. Dos cards (B2 First, C1 Advanced)
 * con lo que la web actual afirma, carga horaria y horarios por sede.
 */
import { getCollection, getEntry } from 'astro:content';
import { Icon } from 'astro-icon/components';
import Boton from '../Boton.astro';
import Etiqueta from '../Etiqueta.astro';

const publico = await getEntry('publicos', 'cambridge');
if (!publico) throw new Error('Falta src/content/publicos/cambridge.yaml');
const cursos = (await getCollection('cursos', ({ data }) => data.publico.id === 'cambridge')).sort(
  (a, b) => a.data.orden - b.data.orden,
);

const horariosConSede = await Promise.all(
  cursos.map(async (c) => ({
    curso: c,
    horarios: await Promise.all(
      c.data.horarios.map(async (h) => ({ ...h, sedeNombre: h.sede ? (await getEntry(h.sede))?.data.nombre : undefined })),
    ),
  })),
);
---

<section id={publico.data.ancla} class="scroll-mt-16 bg-verde-900 py-16 text-white lg:py-24">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="max-w-[60ch]" data-reveal>
      <h2 class="text-3xl text-white sm:text-4xl">{publico.data.titulo}</h2>
      <p class="mt-4 text-lg leading-relaxed text-verde-100">{publico.data.descripcion}</p>
    </div>

    <div class="mt-10 grid gap-6 md:grid-cols-2">
      {
        horariosConSede.map(({ curso, horarios }, i) => (
          <article class="flex flex-col rounded-card bg-white p-6 text-tinta shadow-card sm:p-8" data-reveal style={`--reveal-delay: ${i * 80}ms`}>
            <div class="flex items-start justify-between gap-4">
              <div>
                <p class="text-sm font-semibold text-dorado-800">{curso.data.cambridge?.examen}</p>
                <h3 class="mt-1 text-2xl">{curso.data.nombre}</h3>
              </div>
              {curso.data.cambridge && (
                <Etiqueta tono="dorado" class="text-sm">
                  Nivel {curso.data.cambridge.nivelMcer}
                </Etiqueta>
              )}
            </div>
            <p class="mt-3 leading-relaxed text-tinta-suave">{curso.data.descripcion}</p>

            <dl class="mt-5 grid gap-2 text-sm">
              <div class="flex items-start gap-2">
                <Icon name="material-symbols:schedule-outline" class="mt-0.5 size-4 shrink-0 text-verde-700" aria-hidden="true" />
                <dt class="sr-only">Cursada</dt>
                <dd>
                  {curso.data.frecuencia}, clases de {curso.data.duracionClase}
                  {curso.data.horasSemanales && <strong class="text-verde-900"> ({curso.data.horasSemanales} h por semana)</strong>}.
                  {curso.data.periodo}.
                </dd>
              </div>
              {horarios.map((h) => (
                <div class="flex items-start gap-2">
                  <Icon name="material-symbols:location-on-outline" class="mt-0.5 size-4 shrink-0 text-verde-700" aria-hidden="true" />
                  <dt class="sr-only">Horario</dt>
                  <dd>
                    {h.sedeNombre && <strong class="text-verde-900">{h.sedeNombre}: </strong>}
                    {h.dias} de {h.horas}
                  </dd>
                </div>
              ))}
            </dl>

            {(curso.data.formulario ?? publico.data.formulario) && (
              <div class="mt-6 pt-2">
                <Boton
                  href={curso.data.formulario ?? publico.data.formulario!}
                  variante="primario"
                  icono="material-symbols:open-in-new-rounded"
                  externo
                  class="w-full sm:w-auto"
                >
                  Pedir información
                </Boton>
              </div>
            )}
          </article>
        ))
      }
    </div>
  </div>
</section>
