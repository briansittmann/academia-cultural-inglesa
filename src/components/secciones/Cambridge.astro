---
/**
 * Cambridge: la única banda oscura de la página. A la izquierda, título y
 * descripción (contenido del público "cambridge"); a la derecha, la escala del
 * Marco Común Europeo con los exámenes que se preparan marcados, para que una
 * familia entienda qué significan B2 y C1. Debajo, un examen por fila: nivel
 * grande en dorado, nombre, descripción, cursada y horarios por sede.
 */
import { getCollection, getEntry } from 'astro:content';
import { Icon } from 'astro-icon/components';
import Boton from '../Boton.astro';
import TituloAnimado from '../TituloAnimado.astro';
import { horas } from '../../lib/cursos';

const publico = await getEntry('publicos', 'cambridge');
if (!publico) throw new Error('Falta src/content/publicos/cambridge.yaml');
const cursos = (await getCollection('cursos', ({ data }) => data.publico.id === 'cambridge')).sort(
  (a, b) => a.data.orden - b.data.orden,
);

const examenes = await Promise.all(
  cursos.map(async (c) => ({
    curso: c,
    horarios: await Promise.all(
      c.data.horarios.map(async (h) => ({ ...h, sedeNombre: h.sede ? (await getEntry(h.sede))?.data.nombre : undefined })),
    ),
  })),
);

// Escala del Marco Común Europeo de Referencia para las lenguas (MCER). Es un
// dato público, no del instituto; los exámenes marcados salen de los cursos.
const escalaMcer = [
  { nivel: 'A1', nombre: 'Principiante' },
  { nivel: 'A2', nombre: 'Básico' },
  { nivel: 'B1', nombre: 'Intermedio' },
  { nivel: 'B2', nombre: 'Intermedio alto' },
  { nivel: 'C1', nombre: 'Avanzado' },
  { nivel: 'C2', nombre: 'Dominio' },
];
// Nombre corto del examen para la escala: "B2 First (FCE)" → "First".
const nombreCorto = (examen: string, nivel: string) => examen.replace(/\s*\(.*\)\s*$/, '').replace(new RegExp(`^${nivel}\\s+`), '').trim();
const examenPorNivel = new Map(
  cursos.flatMap((c) => (c.data.cambridge ? [[c.data.cambridge.nivelMcer, nombreCorto(c.data.cambridge.examen, c.data.cambridge.nivelMcer)]] : [])),
);
---

<section id={publico.data.ancla} class="scroll-mt-16 overflow-x-clip bg-verde-900 py-16 text-white lg:py-24">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="grid gap-10 lg:grid-cols-12 lg:items-end lg:gap-12" data-reveal>
      <div class="max-w-[52ch] lg:col-span-6">
        <TituloAnimado as="h2" texto={publico.data.titulo} espera class="text-3xl text-white sm:text-4xl" />
        <p class="sube mt-4 text-lg leading-relaxed text-verde-100" style="--i: 3">{publico.data.descripcion}</p>
      </div>

      <figure class="lg:col-span-6" aria-label="Niveles del Marco Común Europeo">
        <figcaption class="sube text-sm font-semibold text-verde-100/80" style="--i: 3">
          Dónde se ubican en el Marco Común Europeo
        </figcaption>
        {/* Tres columnas (dos filas) en el celular y cuando la escala comparte fila con el
            título (lg en adelante); seis en una fila entre md y lg, donde ocupa todo el ancho.
            Así cada celda tiene lugar para el nombre del nivel sin desbordar. */}
        <ol class="mcer mt-3 grid grid-cols-3 gap-2 md:grid-cols-6 lg:grid-cols-3">
          {
            escalaMcer.map((e, i) => {
              const examen = examenPorNivel.get(e.nivel);
              return (
                <li
                  class:list={[
                    'sube flex min-w-0 flex-col rounded-control border px-3 py-2.5',
                    examen ? 'border-dorado-600 bg-white text-verde-900' : 'border-white/15 bg-white/5 text-verde-100',
                  ]}
                  style={`--i: ${3.5 + i * 0.5}`}
                >
                  <span class:list={['text-xl font-bold leading-none tabular-nums', examen && 'text-dorado-800']}>{e.nivel}</span>
                  <span class:list={['mt-1.5 text-xs leading-snug hyphens-auto', examen ? 'text-tinta-suave' : 'text-verde-100/80']}>
                    {e.nombre}
                  </span>
                  {examen && <span class="mt-auto pt-1.5 text-xs font-bold leading-snug text-verde-900">Examen {examen}</span>}
                </li>
              );
            })
          }
        </ol>
      </figure>
    </div>

    <ol class="mt-12 grid gap-5 lg:mt-14 lg:grid-cols-2 lg:gap-6" data-reveal>
      {
        examenes.map(({ curso, horarios }, i) => (
          <li class="sube flex flex-col rounded-card bg-white p-6 text-tinta shadow-card sm:p-8" style={`--i: ${i * 1.2}`}>
            {/* Nombre a la izquierda y el nivel en dorado a la derecha; el texto usa todo el ancho. */}
            <div class="flex items-start justify-between gap-4">
              <div class="min-w-0">
                <h3 class="text-2xl leading-tight">{curso.data.nombre}</h3>
                <p class="mt-1 text-sm font-semibold text-tinta-suave">
                  <span class="sr-only">Examen: </span>{curso.data.cambridge?.examen}
                </p>
              </div>
              <div class="sello flex size-[4.5rem] shrink-0 flex-col items-center justify-center rounded-control bg-dorado-600/15 text-dorado-800" style={`--i: ${i}`} aria-hidden="true">
                <span class="text-3xl font-bold leading-none tracking-tight tabular-nums">{curso.data.cambridge?.nivelMcer}</span>
                <span class="mt-1 text-[10px] font-semibold tracking-wide uppercase">Nivel</span>
              </div>
            </div>

            <div class="mt-5 flex flex-1 flex-col">
              <p class="leading-relaxed text-tinta-suave">{curso.data.descripcion}</p>

              {/* dt y dd son hijos directos del div (axe: dlitem); el ícono va dentro del dt. */}
              <dl class="mt-5 grid gap-3 border-t border-borde/60 pt-5 text-sm">
                <div>
                  <dt class="flex items-center gap-2.5 font-semibold text-verde-900">
                    <Icon name="material-symbols:schedule-outline" class="size-5 shrink-0 text-verde-700" aria-hidden="true" />
                    Cursada
                  </dt>
                  <dd class="pl-[1.875rem] text-tinta-suave">
                    {curso.data.frecuencia}, clases de {curso.data.duracionClase}
                    {curso.data.horasSemanales && <> ({horas(curso.data.horasSemanales)} h por semana)</>}. {curso.data.periodo}.
                  </dd>
                </div>
                {horarios.length > 0 && (
                  <div>
                    <dt class="flex items-center gap-2.5 font-semibold text-verde-900">
                      <Icon name="material-symbols:location-on-outline" class="size-5 shrink-0 text-verde-700" aria-hidden="true" />
                      {horarios.some((h) => h.sedeNombre) ? 'Horarios por sede' : 'Horario'}
                    </dt>
                    {horarios.map((h) => (
                      <dd class="pl-[1.875rem] text-tinta-suave">
                        {h.sedeNombre && <span class="font-medium text-tinta">{h.sedeNombre}: </span>}
                        {h.dias} de {h.horas}
                      </dd>
                    ))}
                  </div>
                )}
              </dl>

              <div class="mt-auto flex flex-col gap-3 pt-6 sm:flex-row sm:items-center sm:gap-5">
                {(curso.data.formulario ?? publico.data.formulario) && (
                  <Boton
                    href={curso.data.formulario ?? publico.data.formulario!}
                    variante="primario"
                    icono="material-symbols:open-in-new-rounded"
                    externo
                    class="w-full sm:w-auto"
                  >
                    Pedir información
                  </Boton>
                )}
                <a href={`/cursos/${curso.id}`} class="inline-flex items-center gap-1 text-sm font-semibold text-verde-700 underline underline-offset-4 hover:text-verde-900">
                  Más sobre el curso
                  <Icon name="material-symbols:arrow-forward-rounded" class="size-4" aria-hidden="true" />
                </a>
              </div>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>
