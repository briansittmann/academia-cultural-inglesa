---
/**
 * Panel de un público: foto, descripción, cifras del recorrido, progresión real
 * de niveles y CTA "Pedir información". Al entrar en pantalla o al cambiar de
 * pestaña: la foto entra desde la izquierda, las cifras cuentan, la línea del
 * recorrido se dibuja de arriba hacia abajo y cada nivel aparece a su turno.
 */
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { getEntry } from 'astro:content';
import { Icon } from 'astro-icon/components';
import Boton from '../Boton.astro';
import Etiqueta from '../Etiqueta.astro';

interface Props {
  publico: CollectionEntry<'publicos'>;
  cursos: CollectionEntry<'cursos'>[];
  testDeNivelUrl: string;
  activo: boolean;
}
const { publico, cursos, testDeNivelUrl, activo } = Astro.props;

// Nombres de sedes para mostrar (solo cuando el curso las declara).
const sedesPorCurso = new Map<string, string[]>();
for (const c of cursos) {
  const nombres = (await Promise.all(c.data.sedes.map((ref) => getEntry(ref)))).flatMap((s) => (s ? [s.data.nombre] : []));
  sedesPorCurso.set(c.id, nombres);
}

function meta(c: CollectionEntry<'cursos'>) {
  const partes: string[] = [];
  if (c.data.frecuencia) partes.push(c.data.frecuencia);
  if (c.data.duracionClase) partes.push(`clases de ${c.data.duracionClase}`);
  if (c.data.periodo) partes.push(c.data.periodo.toLowerCase());
  return partes;
}
const algunoConTest = cursos.some((c) => c.data.requiereTestDeNivel);

// Cifras del recorrido (se cuentan de 0 al valor al entrar).
const nivelesTotal = cursos.reduce((n, c) => n + Math.max(1, c.data.niveles.length), 0);
const horasMax = Math.max(0, ...cursos.map((c) => c.data.horasSemanales ?? 0));
const cifras = [
  { valor: cursos.length, etiqueta: cursos.length === 1 ? 'curso' : 'cursos' },
  { valor: nivelesTotal, etiqueta: nivelesTotal === 1 ? 'nivel' : 'niveles' },
  ...(horasMax > 0 ? [{ valor: horasMax, etiqueta: 'h por semana' }] : []),
];
---

<div
  id={publico.data.ancla}
  role="tabpanel"
  aria-labelledby={`tab-${publico.data.ancla}`}
  tabindex="0"
  hidden={!activo}
  class="panel-cursos scroll-mt-32 grid gap-8 lg:grid-cols-12 lg:gap-10"
  data-panel
  data-reveal
>
  <div class="lg:col-span-5">
    {
      publico.data.foto && (
        <div class="panel-foto izq aspect-[4/3] overflow-hidden rounded-card shadow-card lg:aspect-[4/5]">
          <Image
            src={publico.data.foto}
            alt={publico.data.fotoAlt ?? ''}
            widths={[480, 800, 1200]}
            sizes="(min-width: 1024px) 40vw, 100vw"
            loading="lazy"
            class="h-full w-full object-cover"
          />
        </div>
      )
    }
    <h3 class="sube mt-6 text-2xl" style="--i: 1">{publico.data.titulo}</h3>
    <p class="sube mt-3 leading-relaxed text-tinta-suave" style="--i: 1.5">{publico.data.descripcion}</p>
    <dl class="mt-5 flex flex-wrap gap-x-6 gap-y-3">
      {
        cifras.map((c, i) => (
          <div class="sube" style={`--i: ${2 + i * 0.6}`}>
            <dt class="sr-only">{c.etiqueta}</dt>
            <dd class="flex items-baseline gap-1.5 whitespace-nowrap">
              <span class="text-3xl font-bold leading-none text-verde-900 tabular-nums" data-cifra={c.valor}>
                {c.valor}
              </span>
              <span class="text-sm text-tinta-suave">{c.etiqueta}</span>
            </dd>
          </div>
        ))
      }
    </dl>
    {
      algunoConTest && (
        <p class="mt-3 text-sm text-tinta-suave">
          Para ubicarte en el nivel correcto, primero hacé el{' '}
          <a href={testDeNivelUrl} target="_blank" rel="noopener" class="font-semibold text-verde-700 underline underline-offset-4 hover:text-verde-900">
            test de nivel online gratuito</a>.
        </p>
      )
    }
    {
      publico.data.formulario && (
        <div class="mt-6 hidden lg:block">
          <Boton href={publico.data.formulario} variante="primario" icono="material-symbols:open-in-new-rounded" externo>
            Pedir información
          </Boton>
        </div>
      )
    }
  </div>

  <ol class="recorrido relative lg:col-span-7 lg:pl-10">
    {
      cursos.map((c, i) => {
        const sedes = sedesPorCurso.get(c.id) ?? [];
        return (
          <li class:list={['curso-item group relative py-6', i > 0 && 'border-t border-borde/60']} style={`--i: ${i}`}>
            <span class="curso-punto absolute top-7 -left-[calc(2.5rem+5px)] hidden size-2.5 rounded-full bg-verde-700 ring-4 ring-crema lg:block" aria-hidden="true" />
            <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
              <h4 class="text-lg">{c.data.nombre}</h4>
              {c.data.etiqueta && <Etiqueta>{c.data.etiqueta}</Etiqueta>}
            </div>
            <p class="mt-1 text-sm font-medium text-verde-700">{c.data.para}</p>
            <p class="mt-2 leading-relaxed text-tinta-suave">{c.data.descripcion}</p>
            {c.data.niveles.length > 1 && (
              <ul class="mt-3 flex flex-wrap gap-1.5" aria-label="Niveles">
                {c.data.niveles.map((n) => (
                  <li>
                    <Etiqueta tono="borde">{n}</Etiqueta>
                  </li>
                ))}
              </ul>
            )}
            <dl class="mt-3 flex flex-wrap gap-x-5 gap-y-1 text-sm text-tinta-suave">
              {meta(c).map((m) => (
                <div>
                  <dt class="sr-only">Cursada</dt>
                  <dd>{m}</dd>
                </div>
              ))}
              {c.data.horasSemanales && (
                <div>
                  <dt class="sr-only">Carga horaria</dt>
                  <dd class="font-semibold text-verde-900">{c.data.horasSemanales} h por semana</dd>
                </div>
              )}
              {c.data.modalidad === 'presencial-y-online' && (
                <div>
                  <dt class="sr-only">Modalidad</dt>
                  <dd>presencial u online</dd>
                </div>
              )}
              {c.data.modalidad === 'online' && (
                <div>
                  <dt class="sr-only">Modalidad</dt>
                  <dd>online</dd>
                </div>
              )}
              {sedes.length > 0 && (
                <div>
                  <dt class="sr-only">Sede</dt>
                  <dd>Sede {sedes.join(' y ')}</dd>
                </div>
              )}
            </dl>
            {/* "Más sobre el curso" es un link en reposo y un botón relleno cuando el mouse
                pasa por el curso (group-hover, solo en dispositivos con hover) o cuando
                recibe el foco del teclado. El padding y el margen negativo están siempre,
                así el cambio no mueve nada: solo aparece el fondo. */}
            <div class="mt-1.5 flex flex-wrap items-center gap-x-5 gap-y-1 text-sm font-semibold">
              <a
                href={`/cursos/${c.id}`}
                class="-mx-3 inline-flex items-center gap-1 rounded-control px-3 py-1.5 text-verde-700 underline underline-offset-4 transition-[background-color,color] duration-200 ease-out group-hover:bg-verde-700 group-hover:text-white group-hover:no-underline focus-visible:bg-verde-700 focus-visible:text-white focus-visible:no-underline"
              >
                Más sobre el curso
                <Icon name="material-symbols:arrow-forward-rounded" class="size-4" aria-hidden="true" />
              </a>
              {c.data.formulario && c.data.formulario !== publico.data.formulario && (
                <a
                  href={c.data.formulario}
                  target="_blank"
                  rel="noopener"
                  class="inline-flex items-center gap-1 text-verde-700 underline underline-offset-4 hover:text-verde-900"
                >
                  Pedir información
                </a>
              )}
            </div>
          </li>
        );
      })
    }
  </ol>

  {
    publico.data.formulario && (
      <div class="lg:hidden">
        <Boton href={publico.data.formulario} variante="primario" icono="material-symbols:open-in-new-rounded" externo class="w-full sm:w-auto">
          Pedir información
        </Boton>
      </div>
    )
  }
</div>
