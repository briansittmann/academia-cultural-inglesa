---
/**
 * Panel de un público: foto (solo escritorio), descripción y progresión real de
 * niveles. Cada curso tiene su botón "Escribir por WhatsApp" con el mensaje ya
 * armado (la vía principal de consulta) y el link a su página; "Pedir
 * información" (formulario del público) queda como opción secundaria al pie del
 * panel, para quien prefiera dejar sus datos. Cada curso muestra primero a quién va
 * dirigido y después los datos para decidir (cursada, período, sede, niveles),
 * con los mismos íconos que la página del curso. En el celular no hay foto, para
 * que los cursos aparezcan apenas se elige la pestaña. Al entrar en pantalla o al
 * cambiar de pestaña: la foto entra desde la izquierda, la línea del recorrido se
 * dibuja de arriba hacia abajo y cada nivel aparece a su turno.
 */
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { getEntry } from 'astro:content';
import { Icon } from 'astro-icon/components';
import Boton from '../Boton.astro';
import Etiqueta from '../Etiqueta.astro';
import { horas, resumirNiveles, whatsappDelCurso } from '../../lib/cursos';

interface Props {
  publico: CollectionEntry<'publicos'>;
  cursos: CollectionEntry<'cursos'>[];
  testDeNivelUrl: string;
  activo: boolean;
}
const { publico, cursos, testDeNivelUrl, activo } = Astro.props;

// Nombres de sedes para mostrar (solo cuando el curso las declara).
const sedesPorCurso = new Map<string, string[]>();
for (const c of cursos) {
  const nombres = (await Promise.all(c.data.sedes.map((ref) => getEntry(ref)))).flatMap((s) => (s ? [s.data.nombre] : []));
  sedesPorCurso.set(c.id, nombres);
}

const modalidades = { presencial: '', online: 'Online', 'presencial-y-online': 'Presencial u online' } as const;

// Datos para decidir, en el orden en que se escanean. Las horas semanales se
// omiten cuando hay una sola clase por semana (repetirían la duración).
function datos(c: CollectionEntry<'cursos'>) {
  const d = c.data;
  // Espacios duros para que "1 h 30" y "3,5 h" no se corten entre renglones.
  const cursada = [d.frecuencia, d.duracionClase && `clases de ${d.duracionClase.replaceAll(' ', '\u00a0')}`].filter(Boolean).join(', ');
  const semanales = d.horasSemanales && !/^1\s/.test(d.frecuencia ?? '') ? `${horas(d.horasSemanales)}\u00a0h semanales` : '';
  const sedes = sedesPorCurso.get(c.id) ?? [];
  const lugar = [modalidades[d.modalidad], sedes.length > 0 && `sede ${sedes.join(' y ')}`].filter(Boolean).join(', ');
  const niveles = resumirNiveles(d.niveles);
  return [
    { etiqueta: 'Cursada', icono: 'material-symbols:schedule-outline', texto: cursada && semanales ? `${cursada} (${semanales})` : cursada || semanales },
    { etiqueta: 'Período', icono: 'material-symbols:event-available-outline', texto: d.periodo ?? '' },
    { etiqueta: 'Modalidad y sede', icono: 'material-symbols:location-on-outline', texto: lugar.charAt(0).toUpperCase() + lugar.slice(1) },
    { etiqueta: 'Niveles', icono: 'material-symbols:stairs-outline', texto: niveles },
  ].filter((x) => x.texto);
}
const algunoConTest = cursos.some((c) => c.data.requiereTestDeNivel);
const whatsappPorCurso = new Map(await Promise.all(cursos.map(async (c) => [c.id, await whatsappDelCurso(c)] as const)));
---

{/* Sin tabindex: cada panel tiene links y botones, así que el teclado entra por ellos.
    Con tabindex="0", al recargar con #ninos en la URL el navegador enfocaba el panel
    y le dibujaba el contorno de foco. */}
<div
  id={publico.data.ancla}
  role="tabpanel"
  aria-labelledby={`tab-${publico.data.ancla}`}
  hidden={!activo}
  class="panel-cursos scroll-mt-36 grid gap-8 lg:grid-cols-12 lg:gap-10"
  data-panel
  data-reveal
>
  <div class="lg:col-span-5">
    {
      publico.data.foto && (
        <div class="panel-foto izq hidden aspect-[4/5] overflow-hidden rounded-card shadow-card lg:block">
          <Image
            src={publico.data.foto}
            alt={publico.data.fotoAlt ?? ''}
            widths={[480, 800, 1200]}
            sizes="40vw"
            loading="lazy"
            class="h-full w-full object-cover"
          />
        </div>
      )
    }
    <h3 class="sube text-2xl lg:mt-6" style="--i: 1">{publico.data.titulo}</h3>
    <p class="sube mt-3 leading-relaxed text-tinta-suave" style="--i: 1.5">{publico.data.descripcion}</p>
    {
      algunoConTest && (
        <p class="mt-4 text-sm text-tinta-suave">
          Para ubicarte en el nivel correcto, primero hacé el{' '}
          <a href={testDeNivelUrl} target="_blank" rel="noopener" class="font-semibold text-verde-700 underline underline-offset-4 hover:text-verde-900">
            test de nivel online gratuito</a>.
        </p>
      )
    }
    {
      publico.data.formulario && (
        <div class="mt-6 hidden lg:block">
          <p class="text-sm text-tinta-suave">¿Preferís dejar tus datos?</p>
          <Boton href={publico.data.formulario} variante="secundario" icono="material-symbols:open-in-new-rounded" externo class="mt-2">
            Pedir información
          </Boton>
        </div>
      )
    }
  </div>

  <ol class="recorrido relative lg:col-span-7 lg:pl-10">
    {
      cursos.map((c, i) => {
        const filas = datos(c);
        return (
          <li class:list={['curso-item group relative py-6 max-lg:first:pt-0', i > 0 && 'border-t border-borde/60']} style={`--i: ${i}`}>
            <span class="curso-punto absolute top-7 -left-[calc(2.5rem+5px)] hidden size-2.5 rounded-full bg-verde-700 ring-4 ring-crema lg:block" aria-hidden="true" />
            <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
              <h4 class="text-xl">{c.data.nombre}</h4>
              {c.data.etiqueta && <Etiqueta>{c.data.etiqueta}</Etiqueta>}
            </div>
            <p class="mt-1 font-semibold text-verde-700">{c.data.para}</p>
            {/* En el celular, tres líneas; el texto completo está en la página del curso. */}
            <p class="mt-2 leading-relaxed text-tinta-suave max-lg:line-clamp-3">{c.data.descripcion}</p>
            {filas.length > 0 && (
              <dl class="mt-4 flex flex-col gap-x-6 gap-y-2 text-[15px] text-tinta sm:flex-row sm:flex-wrap">
                {filas.map((f) => (
                  <div>
                    <dt class="sr-only">{f.etiqueta}</dt>
                    <dd class="flex gap-2">
                      <Icon name={f.icono} class="mt-0.5 size-[1.125rem] shrink-0 text-verde-700" aria-hidden="true" />
                      {f.texto}
                    </dd>
                  </div>
                ))}
              </dl>
            )}
            <div class="mt-5 flex flex-wrap items-center gap-x-6 gap-y-3">
              <Boton
                href={whatsappPorCurso.get(c.id)!.href}
                variante="whatsapp-borde"
                icono="material-symbols:chat-rounded"
                externo
                elegirSede={whatsappPorCurso.get(c.id)!.elegirSede}
              >
                Escribir por WhatsApp
              </Boton>
              <a
                href={`/cursos/${c.id}`}
                class="inline-flex items-center gap-1 text-sm font-semibold text-verde-700 underline underline-offset-4 hover:text-verde-900"
              >
                Más sobre el curso
                <Icon name="material-symbols:arrow-forward-rounded" class="size-4" aria-hidden="true" />
              </a>
            </div>
          </li>
        );
      })
    }
  </ol>

  {
    publico.data.formulario && (
      <div class="border-t border-borde/60 pt-6 lg:hidden">
        <p class="text-sm text-tinta-suave">¿Preferís dejar tus datos?</p>
        <Boton href={publico.data.formulario} variante="secundario" icono="material-symbols:open-in-new-rounded" externo class="mt-2 w-full sm:w-auto">
          Pedir información
        </Boton>
      </div>
    )
  }
</div>
