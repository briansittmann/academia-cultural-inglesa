---
/**
 * Sedes: dos cards con datos reales y mapa con carga diferida.
 */
import { getCollection, getEntry } from 'astro:content';
import SedeCard from './SedeCard.astro';

const instituto = await getEntry('instituto', 'instituto');
if (!instituto) throw new Error('Falta src/content/instituto/instituto.yaml');
const sedes = (await getCollection('sedes')).sort((a, b) => a.data.orden - b.data.orden);
---

<section id="sedes" class="scroll-mt-16 overflow-x-clip bg-verde-50/60 py-16 lg:py-24">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="max-w-[60ch]" data-reveal>
      <h2 class="sube text-3xl sm:text-4xl">Sedes</h2>
      <p class="sube mt-4 text-lg leading-relaxed text-tinta-suave" style="--i: 1">
        Dos sedes en el barrio. Pasá a conocernos o escribinos por WhatsApp a la que te quede más cerca.
      </p>
    </div>
    <div class="mt-10 grid gap-6 md:grid-cols-2 lg:gap-8" data-reveal>
      {
        sedes.map((sede, i) => (
          <div class={i === 0 ? 'izq' : 'der'} style={`--i: ${i * 0.5}`}>
            <SedeCard sede={sede} horarioAtencion={instituto.data.horarioAtencion} />
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  // Carga diferida del mapa: el iframe de Google se inserta recién al pedirlo.
  // Mientras carga, el botón muestra un spinner y el iframe queda invisible debajo;
  // cuando termina, el mapa aparece con un fundido y recién ahí se va el aviso.
  function iniciarMapas() {
    document.querySelectorAll<HTMLElement>('[data-mapa]:not([data-listo])').forEach((caja) => {
      caja.dataset.listo = 'true';
      const boton = caja.querySelector<HTMLButtonElement>('[data-mapa-boton]');
      const estado = caja.querySelector<HTMLElement>('[data-mapa-estado]');
      const aviso = caja.querySelector<HTMLElement>('[data-mapa-placeholder]');
      boton?.addEventListener('click', () => {
        if (boton.hasAttribute('data-cargando')) return;
        boton.setAttribute('data-cargando', '');
        boton.setAttribute('aria-disabled', 'true');
        if (estado) estado.textContent = 'Cargando el mapa';

        const iframe = document.createElement('iframe');
        iframe.src = caja.dataset.src ?? '';
        iframe.title = caja.dataset.titulo ?? 'Mapa';
        iframe.referrerPolicy = 'no-referrer-when-downgrade';
        iframe.allowFullscreen = true;
        iframe.className = 'absolute inset-0 h-full w-full border-0 opacity-0 transition-opacity duration-300';

        let mostrado = false;
        const mostrar = () => {
          if (mostrado) return;
          mostrado = true;
          iframe.classList.remove('opacity-0');
          aviso?.classList.add('transition-opacity', 'duration-300', 'opacity-0');
          // Se oculta en vez de borrarlo: astro-icon define cada símbolo SVG en su
          // primera aparición y el resto de la página lo referencia desde ahí.
          setTimeout(() => aviso?.setAttribute('hidden', ''), 300);
        };
        iframe.addEventListener('load', mostrar, { once: true });
        // Si Google tarda demasiado o el evento no llega, se muestra igual.
        setTimeout(mostrar, 10000);
        caja.prepend(iframe);
      });
    });
  }
  document.addEventListener('astro:page-load', iniciarMapas);
</script>
