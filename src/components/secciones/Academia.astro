---
/**
 * La Academia: fusiona "Por qué nos destacamos" y "Quiénes somos". Cifra grande
 * (meses de clase extra por año, dato real del flyer), hechos verificables y un
 * párrafo corto. Layout asimétrico, sin cards.
 */
import { Image } from 'astro:assets';
import { getEntries, getEntry } from 'astro:content';
import { Icon } from 'astro-icon/components';

const instituto = await getEntry('instituto', 'instituto');
if (!instituto) throw new Error('Falta src/content/instituto/instituto.yaml');
const { cargaHoraria, hechos, descripcion, academia } = instituto.data;
const sedesFoto = (await getEntries(academia?.sedes ?? [])).filter(Boolean).sort((a, b) => a.data.orden - b.data.orden);
const nombresSedes = sedesFoto.map((s) => s.data.nombre).join(' y ');
const fotoAlt = academia?.fotoAlt ?? (sedesFoto.length ? `Sede ${nombresSedes}` : 'Edificio de la Academia');
// "Quiénes somos" se escribe en párrafos en el panel (separados por una línea en blanco).
// El primero va como entrada, más grande.
const [entrada, ...parrafos] = descripcion.split(/\n+/).map((p) => p.trim()).filter(Boolean);
const mitad = Math.ceil(hechos.length / 2);
const columnasHechos = [hechos.slice(0, mitad), hechos.slice(mitad)].filter((c) => c.length > 0);
---

<section id="nosotros" class="scroll-mt-16 py-16 lg:py-24">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-5" data-reveal>
        <h2 class="sube text-3xl sm:text-4xl">La Academia</h2>
        {entrada && <p class="sube mt-5 text-xl leading-snug font-semibold text-verde-900 sm:text-2xl" style="--i: 1">{entrada}</p>}
        <div class="mt-4 space-y-4">
          {
            parrafos.map((p, i) => (
              <p class="sube text-lg leading-relaxed text-tinta-suave" style={`--i: ${1.5 + i * 0.3}`}>
                {p}
              </p>
            ))
          }
        </div>
      </div>

      <div class="lg:col-span-7 lg:pt-2">
        <div data-reveal>
          <div class="zoom relieve relieve-verde tarjeta-elevable tarjeta-academia rounded-card p-6 sm:p-10">
            <h3 class="text-2xl sm:text-3xl">{cargaHoraria.titulo}</h3>
            <div class="mt-8 grid gap-8 sm:grid-cols-2">
              {
                cargaHoraria.detalle.map((d, i) => (
                  <div class="cifra-bloque" style={`--i: ${i}`}>
                    <p class="text-6xl leading-none font-bold tracking-tight text-verde-900 tabular-nums sm:text-7xl">
                      +<span data-cifra={d.mesesExtra}>{d.mesesExtra}</span>
                    </p>
                    <p class="mt-2 text-lg font-semibold text-verde-900">meses de clase por año</p>
                    <p class="mt-1 text-tinta-suave">en los cursos de {d.horasSemanales} h semanales</p>
                  </div>
                ))
              }
            </div>
            <p class="mt-8 max-w-[55ch] leading-relaxed text-tinta-suave">
              Nuestros cursos de 3 y 4 horas semanales suman más clases al año que los de la competencia en la zona. Esa
              diferencia se nota al final del ciclo.
            </p>
          </div>
        </div>

        {
          academia?.foto && (
            // Foto del edificio: se revela como un telón que sube y el zoom se asienta.
            // El recorte va en el hijo, nunca en el elemento observado (ver animaciones.css).
            <figure class="mt-6 lg:mt-8" data-reveal>
              {/* La sombra del hover va en un envoltorio: el telón recorta su propio contenido. */}
              <div class="tarjeta-elevable tarjeta-academia rounded-card">
              <div class="foto-telon overflow-hidden rounded-card shadow-card">
                <Image
                  src={academia.foto}
                  alt={fotoAlt}
                  widths={[480, 800, 1200, 1600]}
                  sizes="(min-width: 1024px) 55vw, 100vw"
                  loading="lazy"
                  class="aspect-[4/3] w-full object-cover object-[center_55%] sm:aspect-[16/10]"
                />
              </div>
              </div>
              {sedesFoto.length > 0 && (
                <figcaption class="sube mt-3 flex flex-wrap gap-x-6 gap-y-1.5 text-sm text-tinta-suave" style="--i: 5">
                  {sedesFoto.map((s) => (
                    <span class="flex items-center gap-2">
                      <Icon name="material-symbols:location-on-outline" class="size-4 shrink-0 text-verde-700" aria-hidden="true" />
                      <span>
                        <span class="font-semibold text-verde-900">Sede {s.data.nombre}</span>, {s.data.direccion}
                      </span>
                    </span>
                  ))}
                </figcaption>
              )}
            </figure>
          )
        }
      </div>
    </div>

    {/* Hechos (los carga la dueña desde el panel) en dos columnas: la primera mitad a la
        izquierda y el resto a la derecha. Son dos listas explícitas y no columnas de CSS
        (columns), que en Safari dejaban la segunda columna más abajo. Cada columna se
        apila sola, así que un hecho de dos líneas no deja un hueco en la otra. La
        cascada va por fila: el primero de cada columna entra a la vez. */}
    <div class="mt-12 grid gap-x-12 gap-y-4 border-t border-borde/60 pt-10 sm:grid-cols-2 sm:items-start lg:mt-14" data-reveal>
      {
        columnasHechos.map((columna) => (
          <ul class="grid gap-4">
            {columna.map((h, fila) => (
              <li class="hecho sube relative flex w-fit origin-left items-start gap-3 overflow-hidden" style={`--i: ${fila * 0.35}`}>
                <Icon name="material-symbols:check-circle-outline" class="mt-0.5 size-5 shrink-0 text-verde-700" aria-hidden="true" />
                <span class="font-medium text-verde-900">{h}</span>
                <span class="hecho-brillo" aria-hidden="true"></span>
              </li>
            ))}
          </ul>
        ))
      }
    </div>
  </div>
</section>
