---
/**
 * Cómo empezar: tres pasos en fila (columna en mobile) alrededor del test de
 * nivel online gratuito, más las dos vías de contacto.
 */
import { getEntry } from 'astro:content';
import Boton from '../Boton.astro';

const instituto = await getEntry('instituto', 'instituto');
if (!instituto) throw new Error('Falta src/content/instituto/instituto.yaml');
const { testDeNivel, formularios } = instituto.data;
---

<section id="test-de-nivel" class="scroll-mt-16 border-y border-borde/50 bg-white py-16 lg:py-24">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="max-w-[60ch]" data-reveal>
      <h2 class="sube text-3xl sm:text-4xl">Cómo empezar</h2>
      <p class="sube mt-4 text-lg leading-relaxed text-tinta-suave" style="--i: 1">
        Si no sabés en qué nivel anotarte, el test online gratuito te lo dice. Son {testDeNivel.preguntas} preguntas y el
        resultado llega por mail.
      </p>
    </div>

    <ol class="mt-10 grid gap-8 md:grid-cols-3 md:gap-6" data-reveal>
      {
        testDeNivel.pasos.map((paso, i) => (
          <li class="paso" style={`--i: ${i}`}>
            <span class="paso-numero block text-4xl font-bold leading-none text-dorado-800" aria-hidden="true">
              {i + 1}
            </span>
            <p class="paso-texto mt-3 leading-relaxed text-tinta">{paso}</p>
          </li>
        ))
      }
    </ol>

    <div class="mt-10 flex flex-col gap-3 sm:flex-row" data-reveal>
      <div class="sube"><Boton href={formularios.testDeNivel} variante="primario" icono="material-symbols:open-in-new-rounded" externo>
        Hacer el test de nivel
      </Boton></div>
      <div class="sube" style="--i: 1"><Boton href={formularios.consultaGeneral} variante="secundario" icono="material-symbols:open-in-new-rounded" externo>
        Pedir información
      </Boton></div>
    </div>
  </div>
</section>
