---
/**
 * Cursos: tabs Niños / Adolescentes / Adultos / Verano (sin "Todos"), un panel
 * por público con la progresión real de niveles. Las anclas #ninos, #adolescentes,
 * #adultos y #verano activan la pestaña correspondiente. Las pestañas quedan fijas
 * debajo del header mientras se recorre la sección (en el celular un panel ocupa
 * varias pantallas) y, si se cambia de pestaña con la franja fija, la página sube
 * al principio del panel nuevo. Indicador animado con la
 * receta "tab indicator": una copia de la lista en estado activo, recortada con
 * clip-path hasta la pestaña elegida.
 */
import { getCollection, getEntry } from 'astro:content';
import CursosPanel from './CursosPanel.astro';
import { anclaDelPanel } from '../../lib/cursos';

const instituto = await getEntry('instituto', 'instituto');
if (!instituto) throw new Error('Falta src/content/instituto/instituto.yaml');

const publicos = (await getCollection('publicos', ({ data }) => data.enTabs)).sort((a, b) => a.data.orden - b.data.orden);
const cursos = (await getCollection('cursos')).sort((a, b) => a.data.orden - b.data.orden);
---

<section id="cursos" class="scroll-mt-16 overflow-x-clip bg-verde-50/60 py-16 lg:py-24">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div data-reveal>
    <h2 class="sube text-3xl sm:text-4xl">Cursos por edad</h2>
    <p class="sube mt-3 max-w-[60ch] text-lg text-tinta-suave" style="--i: 1">
      Elegí tu grupo y mirá la progresión de niveles, la carga horaria y las fechas de cada curso.
    </p>
    </div>

    {/* Franja fija: el fondo es el color que resulta del verde-50/60 de la sección sobre el crema. */}
    <div
      class="sticky top-16 z-30 mt-6 -mx-4 overflow-x-auto bg-[color-mix(in_oklab,var(--color-verde-50)_60%,var(--color-crema))] px-4 py-2 sm:-mx-6 sm:px-6 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
      data-tabs-scroll
    >
      <div class="relative inline-flex" data-tabs-wrap>
        <div role="tablist" aria-label="Públicos" class="flex gap-2" data-tabs>
          {
            publicos.map((p, i) => (
              <button
                type="button"
                role="tab"
                id={`tab-${anclaDelPanel(p)}`}
                aria-selected={i === 0 ? 'true' : 'false'}
                aria-controls={anclaDelPanel(p)}
                tabindex={i === 0 ? 0 : -1}
                class="shrink-0 rounded-full border border-borde bg-white px-5 py-2.5 text-sm font-semibold text-tinta-suave hover:border-verde-700 hover:text-verde-900 aria-selected:border-verde-700 aria-selected:bg-verde-700 aria-selected:text-white [.js_&]:aria-selected:border-borde [.js_&]:aria-selected:bg-white [.js_&]:aria-selected:text-tinta-suave"
                data-tab
              >
                {p.data.nombre}
              </button>
            ))
          }
        </div>
        {/* Copia en estado activo, solo visual; el recorte la limita a la pestaña elegida. */}
        <div class="tabs-copia pointer-events-none absolute inset-0 hidden gap-2 [.js_&]:flex" aria-hidden="true" data-tabs-copia>
          {
            publicos.map((p) => (
              <span class="shrink-0 rounded-full border border-verde-700 bg-verde-700 px-5 py-2.5 text-sm font-semibold whitespace-nowrap text-white">
                {p.data.nombre}
              </span>
            ))
          }
        </div>
      </div>
    </div>

    <div class="mt-6 lg:mt-8" data-paneles>
      {
        publicos.map((p, i) => (
          <CursosPanel
            publico={p}
            cursos={cursos.filter((c) => c.data.publico.id === p.id)}
            testDeNivelUrl={instituto.data.formularios.testDeNivel}
            activo={i === 0}
          />
        ))
      }
    </div>
  </div>
</section>

<script>
  function iniciarTabs() {
    const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-tab]'));
    const panels = Array.from(document.querySelectorAll<HTMLElement>('[data-panel]'));
    const wrap = document.querySelector<HTMLElement>('[data-tabs-wrap]');
    const copia = document.querySelector<HTMLElement>('[data-tabs-copia]');
    if (tabs.length === 0 || !wrap || !copia || wrap.dataset.listo) return;
    wrap.dataset.listo = 'true';

    function moverIndicador(tab: HTMLElement) {
      const izq = tab.offsetLeft;
      const der = wrap!.clientWidth - (tab.offsetLeft + tab.offsetWidth);
      copia!.style.setProperty('--clip-izq', `${izq}px`);
      copia!.style.setProperty('--clip-der', `${der}px`);
    }

    function activar(id: string, opciones: { enfocar?: boolean; animarLista?: boolean } = {}) {
      tabs.forEach((t) => {
        const sel = t.getAttribute('aria-controls') === id;
        t.setAttribute('aria-selected', String(sel));
        t.tabIndex = sel ? 0 : -1;
        if (sel) {
          moverIndicador(t);
          t.scrollIntoView({ block: 'nearest', inline: 'nearest' });
          if (opciones.enfocar) t.focus();
        }
      });
      panels.forEach((p) => {
        const mostrar = p.id === id;
        const yaRevelado = p.hasAttribute('data-visible');
        p.hidden = !mostrar;
        // Si el panel ya se había revelado, se repite la entrada; si no, la
        // dispara el observer de Base.astro al quedar visible.
        if (mostrar && opciones.animarLista && yaRevelado) {
          p.removeAttribute('data-visible');
          void p.offsetWidth;
          p.dispatchEvent(new CustomEvent('revelar', { bubbles: true }));
        }
      });
    }

    // Con la franja de pestañas fija, el panel nuevo puede quedar arriba, fuera de
    // la vista (o ser más corto y dejar la página al final). Se sube a su principio.
    const franja = document.querySelector<HTMLElement>('[data-tabs-scroll]');
    const paneles = document.querySelector<HTMLElement>('[data-paneles]');
    function subirSiHaceFalta(id: string) {
      if (!franja || !paneles) return;
      if (paneles.getBoundingClientRect().top < franja.getBoundingClientRect().bottom) {
        document.getElementById(id)?.scrollIntoView({ block: 'start' });
      }
    }

    tabs.forEach((t) =>
      t.addEventListener('click', () => {
        const id = t.getAttribute('aria-controls')!;
        activar(id, { animarLista: true });
        history.replaceState(null, '', `#${id}`);
        subirSiHaceFalta(id);
      }),
    );

    document.querySelector('[data-tabs]')?.addEventListener('keydown', (e) => {
      const ev = e as KeyboardEvent;
      const i = tabs.findIndex((t) => t === document.activeElement);
      if (i < 0) return;
      let j = i;
      if (ev.key === 'ArrowRight') j = (i + 1) % tabs.length;
      else if (ev.key === 'ArrowLeft') j = (i - 1 + tabs.length) % tabs.length;
      else if (ev.key === 'Home') j = 0;
      else if (ev.key === 'End') j = tabs.length - 1;
      else return;
      ev.preventDefault();
      activar(tabs[j].getAttribute('aria-controls')!, { enfocar: true, animarLista: true });
    });

    function desdeHash() {
      const id = location.hash.slice(1);
      if (panels.some((p) => p.id === id)) {
        activar(id, { animarLista: true });
        document.getElementById('cursos')?.scrollIntoView();
      }
    }
    window.addEventListener('hashchange', desdeHash);
    window.addEventListener('resize', () => {
      const activa = tabs.find((t) => t.getAttribute('aria-selected') === 'true');
      if (activa) moverIndicador(activa);
    });

    // Estado inicial sin transición: el indicador aparece ya en su lugar.
    copia.style.transition = 'none';
    desdeHash();
    const activa = tabs.find((t) => t.getAttribute('aria-selected') === 'true');
    if (activa) moverIndicador(activa);
    void copia.offsetWidth;
    copia.style.transition = '';
  }
  document.addEventListener('astro:page-load', iniciarTabs);
</script>
