---
/**
 * Novedades vigentes, justo debajo de la portada: lo que la dueña carga desde
 * el panel con la casilla "Vigente" (flyer, título, período, resumen). Cada
 * tarjeta lleva a la página de la novedad. Si no hay vigentes, no se muestra.
 */
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';
import Etiqueta from '../Etiqueta.astro';

const vigentes = (await getCollection('novedades', ({ data }) => data.vigente)).sort((a, b) => a.data.orden - b.data.orden);
---

{
  vigentes.length > 0 && (
    <section id="novedades" class="scroll-mt-16 border-t border-borde/50 py-12 lg:py-16" aria-labelledby="novedades-titulo">
      <div class="mx-auto max-w-6xl px-4 sm:px-6">
        <div data-reveal>
          <h2 id="novedades-titulo" class="sube text-2xl sm:text-3xl">
            Novedades
          </h2>
          <ul class="mt-6 grid gap-4 md:grid-cols-2 lg:gap-6">
            {vigentes.map((n, i) => (
              <li class="sube" style={`--i: ${1 + i * 0.6}`}>
                <a
                  href={`/novedades/${n.id}`}
                  class="tarjeta-link grid h-full grid-cols-[auto_1fr] gap-4 rounded-card border border-borde/60 bg-white p-4 shadow-card sm:gap-5 sm:p-5"
                >
                  {n.data.flyer ? (
                    <Image
                      src={n.data.flyer}
                      alt=""
                      width={320}
                      densities={[1, 2]}
                      class="aspect-[4/5] w-24 rounded-control object-cover sm:w-32"
                    />
                  ) : (
                    <span class="flex aspect-[4/5] w-24 items-center justify-center rounded-control bg-verde-100 text-verde-700 sm:w-32" aria-hidden="true">
                      <Icon name="material-symbols:event-available-outline" class="size-9" />
                    </span>
                  )}
                  <span class="flex min-w-0 flex-col">
                    <Etiqueta tono="dorado" class="self-start">{n.data.periodo}</Etiqueta>
                    <span class="mt-2 text-xl font-bold leading-tight text-verde-900">{n.data.titulo}</span>
                    <span class="mt-1.5 line-clamp-3 text-sm leading-relaxed text-tinta-suave">{n.data.resumen}</span>
                    <span class="mt-auto inline-flex items-center gap-1 pt-3 text-sm font-semibold text-verde-700">
                      Ver más
                      <Icon name="material-symbols:arrow-forward-rounded" class="size-4" aria-hidden="true" />
                    </span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>
  )
}
