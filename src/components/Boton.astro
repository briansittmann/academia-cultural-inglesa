---
/**
 * Botón / link con aspecto de botón. Cuatro variantes, dos intenciones en toda la
 * página: "Pedir información" (formulario) y "Escribir por WhatsApp" (contacto).
 * "whatsapp-borde" es la versión discreta para los botones que se repiten (uno
 * por curso): blanca con borde, se rellena de verde WhatsApp al pasar el mouse o
 * con el foco del teclado.
 * elegirSede: el botón abre el selector de sede (SelectorSede.astro) en vez de ir
 * directo al chat; si es un texto, es el mensaje precargado para cualquier sede.
 * Receta "button press" de motion-skills: solo transform, 160 ms, ease-out.
 */
import { Icon } from 'astro-icon/components';

interface Props {
  href: string;
  variante?: 'primario' | 'secundario' | 'whatsapp' | 'whatsapp-borde';
  icono?: string; // nombre de Material Symbols, ej. "material-symbols:chat-rounded"
  externo?: boolean; // target _blank + rel
  elegirSede?: boolean | string;
  class?: string;
}
const { href, variante = 'primario', icono, externo = false, elegirSede = false, class: className } = Astro.props;

const base =
  'boton inline-flex min-h-12 items-center justify-center gap-2 rounded-control px-5 font-semibold whitespace-nowrap no-underline';
const variantes = {
  primario: 'bg-verde-700 text-white hover:bg-verde-900',
  secundario: 'border border-borde bg-white text-verde-900 hover:border-verde-700 hover:bg-verde-50',
  whatsapp: 'bg-whatsapp text-tinta hover:bg-[#1fb857]',
  'whatsapp-borde':
    'border border-borde bg-white text-verde-900 hover:border-whatsapp hover:bg-whatsapp hover:text-tinta focus-visible:border-whatsapp focus-visible:bg-whatsapp focus-visible:text-tinta',
};
---

<a
  href={href}
  class:list={[base, variantes[variante], className]}
  target={externo ? '_blank' : undefined}
  rel={externo ? 'noopener' : undefined}
  aria-haspopup={elegirSede ? 'dialog' : undefined}
  data-elegir-sede={elegirSede ? '' : undefined}
  data-mensaje={typeof elegirSede === 'string' ? elegirSede : undefined}
>
  {icono && <Icon name={icono} class="size-5 shrink-0" aria-hidden="true" />}
  <slot />
</a>

<style>
  .boton {
    transition:
      transform 160ms var(--ease-out),
      background-color 160ms var(--ease-out),
      border-color 160ms var(--ease-out),
      color 160ms var(--ease-out);
  }
  .boton:active {
    transform: scale(0.97);
  }
  /* El hover solo cambia color (ya está en las clases); se gata para no quedar pegado en touch. */
  @media not ((hover: hover) and (pointer: fine)) {
    .boton:hover:not(:focus-visible) {
      background-color: revert-layer;
      border-color: revert-layer;
      color: revert-layer;
    }
  }
</style>
