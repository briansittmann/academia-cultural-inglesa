---
/**
 * Logo del instituto (escudo con los dos leones). Hoy es el PNG que entregó el
 * instituto (src/assets/logo/logo.png, 1254 px); se usa la versión recortada sin
 * márgenes transparentes y se sirve como <img> optimizada por astro:assets, a 2x
 * para pantallas retina. Cuando llegue el SVG original, se reemplaza acá.
 */
import { Image } from 'astro:assets';
import logo from '../assets/logo/logo-recortado.png';

interface Props {
  size?: number; // alto en px
  class?: string;
  alt?: string; // vacío cuando va junto al nombre del instituto
}
const { size = 40, class: className, alt = '' } = Astro.props;
const width = Math.round((size * logo.width) / logo.height);
---

<Image src={logo} width={width} height={size} densities={[1, 2]} alt={alt} class={className} loading="eager" decoding="async" />
