---
/**
 * Header fijo de 64 px: escudo + nombre, 4 anclas, un solo CTA (WhatsApp).
 * En mobile, hamburguesa que abre un panel con las mismas anclas y el CTA
 * (receta accordion: altura medida en JS, 200 ms, ease-out).
 */
import { getEntry } from 'astro:content';
import { Icon } from 'astro-icon/components';
import Logo from './Logo.astro';
import Boton from './Boton.astro';

const instituto = await getEntry('instituto', 'instituto');
if (!instituto) throw new Error('Falta src/content/instituto/instituto.yaml');
const sede = await getEntry(instituto.data.whatsappPrincipal);
if (!sede) throw new Error('La sede del WhatsApp principal no existe');

const whatsappUrl = `https://wa.me/${sede.data.whatsapp.internacional}?text=${encodeURIComponent(sede.data.whatsapp.mensaje ?? '')}`;

const anclas = [
  { href: '#cursos', texto: 'Cursos' },
  { href: '#cambridge', texto: 'Cambridge' },
  { href: '#sedes', texto: 'Sedes' },
  { href: '#nosotros', texto: 'Nosotros' },
];
---

<header class="sticky top-0 z-40 border-b border-borde/50 bg-crema/90 backdrop-blur-md" data-header>
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-4 sm:px-6">
    <a href="#inicio" class="flex min-w-0 items-center gap-3 rounded-control" aria-label={`${instituto.data.nombre}, ir al inicio`}>
      <span class="header-logo flex shrink-0"><Logo size={40} alt="" /></span>
      <span class="truncate text-[15px] font-bold leading-tight text-verde-900 sm:text-base">{instituto.data.nombre}</span>
    </a>

    <nav aria-label="Secciones" class="hidden items-center gap-1 md:flex">
      {
        anclas.map((a) => (
          <a
            href={a.href}
            class="rounded-control px-3 py-2 text-sm font-semibold text-tinta-suave hover:bg-verde-100 hover:text-verde-900"
          >
            {a.texto}
          </a>
        ))
      }
    </nav>

    <div class="hidden md:block">
      <Boton href={whatsappUrl} variante="whatsapp" icono="material-symbols:chat-rounded" externo class="min-h-10 px-4 text-sm">
        Escribir por WhatsApp
      </Boton>
    </div>

    <button
      type="button"
      class="inline-flex size-11 items-center justify-center rounded-control text-verde-900 hover:bg-verde-100 md:hidden"
      aria-expanded="false"
      aria-controls="menu-mobile"
      data-menu-boton
    >
      <span class="sr-only">Abrir menú</span>
      <Icon name="material-symbols:menu-rounded" class="size-7" aria-hidden="true" data-icono-abrir />
      <Icon name="material-symbols:close-rounded" class="hidden size-7" aria-hidden="true" data-icono-cerrar />
    </button>
  </div>

  <div id="menu-mobile" class="menu-panel border-borde/50 bg-crema md:hidden" inert data-menu-panel>
    <nav aria-label="Secciones" class="mx-auto flex max-w-6xl flex-col border-t border-borde/50 px-4 py-3 sm:px-6">
      {
        anclas.map((a) => (
          <a href={a.href} class="rounded-control px-3 py-3 text-base font-semibold text-verde-900 hover:bg-verde-100" data-menu-link>
            {a.texto}
          </a>
        ))
      }
      <div class="mt-2 pb-2">
        <Boton href={whatsappUrl} variante="whatsapp" icono="material-symbols:chat-rounded" externo class="w-full">
          Escribir por WhatsApp
        </Boton>
      </div>
    </nav>
  </div>
</header>

<script>
  function iniciarMenu() {
    const boton = document.querySelector<HTMLButtonElement>('[data-menu-boton]');
    const panel = document.querySelector<HTMLElement>('[data-menu-panel]');
    const abrir = document.querySelector<SVGElement>('[data-icono-abrir]');
    const cerrar = document.querySelector<SVGElement>('[data-icono-cerrar]');
    if (!boton || !panel || !abrir || !cerrar || boton.dataset.listo) return;
    boton.dataset.listo = 'true';

    function setAbierto(abierto: boolean) {
      boton!.setAttribute('aria-expanded', String(abierto));
      boton!.querySelector('.sr-only')!.textContent = abierto ? 'Cerrar menú' : 'Abrir menú';
      abrir!.classList.toggle('hidden', abierto);
      cerrar!.classList.toggle('hidden', !abierto);
      // Accordion: se anima a la altura medida, nunca a "auto".
      panel!.style.height = abierto ? `${panel!.scrollHeight}px` : '0px';
      panel!.toggleAttribute('data-abierto', abierto);
      if (abierto) panel!.removeAttribute('inert');
      else panel!.setAttribute('inert', '');
    }

    boton.addEventListener('click', () => setAbierto(boton.getAttribute('aria-expanded') !== 'true'));
    panel.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setAbierto(false)));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') setAbierto(false);
    });
    window.matchMedia('(min-width: 768px)').addEventListener('change', (e) => {
      if (e.matches) setAbierto(false);
    });

    // Header compacto: se activa cuando el centinela del tope sale del viewport.
    const header = document.querySelector<HTMLElement>('[data-header]');
    const centinela = document.querySelector('[data-centinela]');
    if (header && centinela && 'IntersectionObserver' in window) {
      new IntersectionObserver(([e]) => header.toggleAttribute('data-compacto', !e.isIntersecting), {
        rootMargin: '48px 0px 0px 0px',
      }).observe(centinela);
    }
  }
  document.addEventListener('astro:page-load', iniciarMenu);
</script>
